# ==========================================
# MishkaBot Configuration
# ==========================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=

# Base chance to receive a Mishka per message in percentage (e.g. 5 = 5%)
MISHKA_CHANCE=5

# Relative chances for each bear type in percentage.
# IMPORTANT: The sum of these 4 chances MUST equal exactly 100!
COMMON_MISHKA_CHANCE=70
RARE_MISHKA_CHANCE=20
EPIC_MISHKA_CHANCE=8
LEGENDARY_MISHKA_CHANCE=2

# SQLite database file path
DATABASE_PATH=data/mishka.db

# Minimum cooldown between eligible messages per user to prevent spam (in seconds)
SPAM_COOLDOWN_SECONDS=3

# Optional: Superadmin Telegram IDs separated by commas (allows admin commands in private chats)
ADMIN_IDS=
