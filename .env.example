# ==========================================
# Telegram Gifts & Stars Bot Configuration
# ==========================================

# 1. Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=

# 2. Chance to drop a real Telegram Gift per message (in %, e.g. 5 = 5%)
GIFT_DROP_CHANCE=5

# 3. Target Telegram Group Chat ID where the bot will drop gifts (e.g. -1001234567890)
# Leave empty to allow any group where the bot is admin
TARGET_CHAT_ID=

# 4. Optional: Comma-separated list of allowed Gift IDs from Telegram API
# Leave empty to allow all gifts within MAX_GIFT_PRICE_STARS
ENABLED_GIFT_IDS=

# 5. Maximum Telegram Stars price for a single gift drop (0 = no limit)
MAX_GIFT_PRICE_STARS=50

# 6. Stars source: 'bot' (uses bot's Telegram Stars balance) or 'user_session'
STARS_SOURCE=bot

# 7. Optional Telegram Client API credentials (for MTProto session)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
SESSION_NAME=secrets/user_session

# 8. Storage & Spam protection
DATABASE_PATH=data/bot.db
SPAM_COOLDOWN_SECONDS=3

# 9. Superadmin Telegram User IDs separated by comma
ADMIN_IDS=
